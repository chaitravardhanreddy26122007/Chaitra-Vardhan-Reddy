<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>React Components Demo - Task Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      background-color: #09090b;
      color: #fafafa;
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .active-tab {
      background-color: #27272a;
      color: #ffffff;
      border-color: #3b82f6;
    }
  </style>
</head>
<body class="min-h-screen bg-zinc-950 text-zinc-100 flex flex-col">
  <!-- Top Navigation -->
  <header class="border-b border-zinc-800 bg-zinc-900/60 backdrop-blur-md sticky top-0 z-40 px-6 py-3.5 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/" class="text-sm font-medium text-zinc-400 hover:text-white transition flex items-center gap-1.5">
        ← Back to Tasks Dashboard
      </a>
      <span class="text-zinc-600">/</span>
      <span class="text-sm font-semibold text-white">React Components Showcase</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-400 font-medium border border-blue-500/20">
        shadcn + Tailwind + TypeScript
      </span>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-6xl w-full mx-auto p-6 md:p-10 flex flex-col">
    <!-- Header with component info -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800 pb-5">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
          <span>Trello Kanban Board & Component Demos</span>
        </h1>
        <p class="text-sm text-zinc-400 mt-1">
          Interactive demonstration of <code class="text-blue-400 font-mono text-xs bg-zinc-800 px-1.5 py-0.5 rounded">trello-kanban-board.tsx</code> and <code class="text-blue-400 font-mono text-xs bg-zinc-800 px-1.5 py-0.5 rounded">demo.tsx</code> integrated into the Express.js File-System app.
        </p>
      </div>

      <!-- Tab Switcher -->
      <div class="flex items-center gap-1 bg-zinc-900 p-1 rounded-lg border border-zinc-800 text-xs font-medium">
        <button 
          id="btn-tab-kanban-demo" 
          onclick="switchTab('kanban-demo')"
          class="px-3 py-1.5 rounded-md transition active-tab"
        >
          Kanban Board Demo (demo.tsx)
        </button>
        <button 
          id="btn-tab-kanban-live" 
          onclick="switchTab('kanban-live')"
          class="px-3 py-1.5 rounded-md text-zinc-400 hover:text-white transition"
        >
          Live fs Tasks Board
        </button>
        <button 
          id="btn-tab-share" 
          onclick="switchTab('share')"
          class="px-3 py-1.5 rounded-md text-zinc-400 hover:text-white transition"
        >
          Share Dialog Demo
        </button>
      </div>
    </div>

    <!-- TAB 1: Kanban Board Demo (from demo.tsx) -->
    <div id="tab-kanban-demo" class="tab-pane w-full">
      <div class="mb-4 text-xs text-zinc-400 bg-zinc-900/60 p-3 rounded-lg border border-zinc-800 flex items-center justify-between">
        <div>
          <span class="font-semibold text-zinc-200">Component Source:</span>
          <code class="text-blue-400 ml-1">/components/ui/demo.tsx</code> rendering <code class="text-blue-400">/components/ui/trello-kanban-board.tsx</code>
        </div>
        <span class="text-zinc-500">Drag tasks between columns below:</span>
      </div>
      <div id="react-kanban-demo-root" class="w-full"></div>
    </div>

    <!-- TAB 2: Live File System Board -->
    <div id="tab-kanban-live" class="tab-pane w-full hidden">
      <div class="mb-4 text-xs text-zinc-400 bg-zinc-900/60 p-3 rounded-lg border border-zinc-800 flex items-center justify-between">
        <div>
          <span class="font-semibold text-zinc-200">Dynamic Storage:</span>
          Synced with <code class="text-blue-400">./files/*.txt</code> via Express <code class="text-blue-400">/api/tasks</code>
        </div>
        <span class="text-zinc-500">Adding a card saves a new .txt file to disk</span>
      </div>
      <div id="react-kanban-root" class="w-full"></div>
    </div>

    <!-- TAB 3: Share Dialog Demo -->
    <div id="tab-share" class="tab-pane w-full hidden">
      <div 
        id="react-share-demo-root" 
        data-filename="<%= filename %>" 
        data-url="http://localhost:3000/file/<%= encodeURIComponent(filename) %>"
        class="w-full flex justify-center py-4"
      ></div>
    </div>
  </main>

  <script>
    function switchTab(tab) {
      document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('button[id^="btn-tab-"]').forEach(btn => {
        btn.classList.remove('active-tab', 'text-white');
        btn.classList.add('text-zinc-400');
      });

      const activeTabEl = document.getElementById('tab-' + tab);
      const activeBtnEl = document.getElementById('btn-tab-' + tab);
      if (activeTabEl && activeBtnEl) {
        activeTabEl.classList.remove('hidden');
        activeBtnEl.classList.add('active-tab', 'text-white');
        activeBtnEl.classList.remove('text-zinc-400');
      }
    }
  </script>

  <!-- Bundled React Scripts -->
  <script src="/js/task-share.bundle.js"></script>
  <script src="/js/kanban-board.bundle.js"></script>
</body>
</html>
