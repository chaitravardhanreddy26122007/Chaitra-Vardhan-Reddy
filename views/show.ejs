<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= filename %> - Task Details</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background-color: #161619;
      color: #ffffff;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
  </style>
</head>
<body class="bg-zinc-900 text-white min-h-screen">
  <div class="main w-full min-h-screen p-10">
    <!-- Back to Home Link -->
    <a class="text-blue-500 inline-flex items-center gap-1 mb-8 hover:underline text-sm font-medium" href="/">
      ← Go Back to Home
    </a>

    <div class="max-w-3xl bg-zinc-800 rounded-lg p-8 border border-zinc-700/60 shadow-lg">
      <div class="flex items-center justify-between pb-4 border-b border-zinc-700 mb-6">
        <div>
          <span class="text-xs uppercase tracking-wider text-blue-400 font-semibold">Task File</span>
          <h1 class="text-3xl font-bold tracking-tight text-white mt-1 break-all"><%= filename %></h1>
        </div>
        <div class="flex items-center gap-3">
          <button 
            type="button" 
            onclick="window.openTaskShareModal && window.openTaskShareModal('<%= filename %>')"
            class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-md transition font-medium flex items-center gap-1.5"
            title="Share task file with collaborators"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
            Share Task
          </button>
          <a 
            href="/edit/<%= encodeURIComponent(filename) %>" 
            class="px-4 py-1.5 bg-yellow-600/80 hover:bg-yellow-600 text-white text-sm rounded-md transition font-medium"
          >
            Rename File
          </a>
          <form action="/delete/<%= encodeURIComponent(filename) %>" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete <%= filename %>?');">
            <button 
              type="submit" 
              class="px-4 py-1.5 bg-red-600/80 hover:bg-red-600 text-white text-sm rounded-md transition font-medium"
            >
              Delete
            </button>
          </form>
        </div>
      </div>

      <!-- File Content Details -->
      <div class="mt-4">
        <label class="block text-xs uppercase tracking-wider text-zinc-400 font-semibold mb-2">Details / Content</label>
        <div class="bg-zinc-900/80 rounded-md p-6 border border-zinc-700/40 text-zinc-200 text-base leading-relaxed whitespace-pre-wrap font-mono min-h-[160px]">
<%= filedata && filedata.length > 0 ? filedata : "(No content found in this file)" %>
        </div>
      </div>
    </div>
  </div>

  <!-- React Share Component Bundle -->
  <script src="/js/task-share.bundle.js" defer></script>
</body>
</html>
